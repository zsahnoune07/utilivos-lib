{
  "id": "com.utilivos.plugin.qr-code-scanner",
  "name": "QR Code Scanner",
  "slug": "qr-code-scanner",
  "version": "1.0.1",
  "description": "Scan QR codes with your camera or decode them from a photo in your library.",
  "author": "Utilivos Developer",
  "entry": "tool/index.html",
  "icon": "tool/assets/icon.png",
  "thumb": "tool/assets/thumb.png",
  "category": "utilities",
  "tags": [
    "qr",
    "scanner",
    "barcode",
    "camera",
    "offline",
    "utilivos"
  ],
  "tier": "free",
  "permissions": [
    "storage",
    "camera"
  ],
  "ui_type": "page",
  "api_version": "1",
  "screenshots": [
    "tool/assets/screenshots/home.png"
  ],
  "min_app_version": "1.0.0",
  "locales": [
    "en"
  ],
  "default_locale": "en",
  "manifest_schema_version": 1,
  "design_system_version": 1,
  "supports_dark_mode": true,
  "runtime_mode": "bundled"
}
